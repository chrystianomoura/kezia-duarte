---
// Linha reta para sublinhar títulos. Estica na largura do pai (w-full);
// a cor vem de `currentColor` (use text-*) e a espessura não deforma ao esticar.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={cls} viewBox="0 0 800 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" preserveAspectRatio="none" aria-hidden="true">
  <path vector-effect="non-scaling-stroke" d="M2 12H798" />
</svg>
