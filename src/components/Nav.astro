---
import Wordmark from './Wordmark.astro';
import { nav, whatsappUrl, messages } from '../data/content';
interface Props { tone?: 'dark' | 'light'; class?: string }
const { tone = 'dark', class: cls = '' } = Astro.props;
const link = tone === 'dark' ? 'text-profundo hover:text-sereno' : 'text-white/90 hover:text-white';
const btn = tone === 'dark' ? 'bg-marinho text-white hover:bg-sereno' : 'bg-white text-marinho hover:bg-nevoa';
---
<header class={`relative z-20 mx-auto flex w-full max-w-6xl items-center justify-center gap-6 px-5 py-6 sm:justify-between sm:px-8 ${cls}`}>
  <Wordmark {tone} />
  <nav class="hidden items-center gap-8 text-[1.1rem] lg:flex" aria-label="Principal">
    {nav.slice(1, 5).map((i) => <a href={i.href} class={`transition-colors ${link}`}>{i.label}</a>)}
  </nav>
  <a href={whatsappUrl(messages.nav)} class={`hidden rounded-full px-6 py-3 text-[.95rem] font-semibold transition-colors sm:inline-block ${btn}`}>
    Agendar sessão
  </a>
</header>
