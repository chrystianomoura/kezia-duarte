---
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { nav, site, whatsappUrl, messages } from '../data/content';
interface Props { tone?: 'dark' | 'light'; class?: string }
const { tone = 'dark', class: cls = '' } = Astro.props;
const link = tone === 'dark' ? 'font-medium text-[#575d63] hover:text-marinho lg:text-white/90 lg:hover:text-white' : 'text-white/90 hover:text-white';
// Sublinhado que abre do centro para as pontas ao passar o mouse (ou focar) no item.
const underline = 'relative after:absolute after:inset-x-0 after:-bottom-1.5 after:h-[1.5px] after:origin-center after:scale-x-0 after:rounded-full after:bg-current after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100 focus-visible:after:scale-x-100';
const btn = tone === 'dark' ? 'bg-marinho text-white hover:bg-profundo lg:bg-white lg:text-marinho lg:hover:bg-nevoa' : 'bg-white text-marinho hover:bg-nevoa';
---
<!-- Celular: marca centralizada (em telas estreitas reserva espaço à direita para o botão do menu não ficar sobre ela). Desktop: marca à esquerda, links e CTA. -->
<!-- Desktop: o cabeçalho é uma faixa de ponta a ponta na cor do rodapé, com a marca e os links em branco. -->
<div class="lg:bg-marinho">
<header class={`relative z-20 mx-auto flex w-full max-w-6xl items-center justify-center gap-6 px-5 py-6 max-[399px]:pr-20 sm:justify-between sm:px-8 ${cls}`}>
  <Wordmark {tone} />
  <nav class="hidden items-center gap-5 text-[1rem] lg:flex xl:gap-7 xl:text-[1.1rem]" aria-label="Principal">
    {nav.map((i) => <a href={i.href} class={`transition-colors ${underline} ${link}`}>{i.label}</a>)}
    <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener" aria-label="Instagram" class={`transition-colors ${underline} ${link}`}><Icon name="instagram" class="h-7 w-7" /></a>
  </nav>
  <a href={whatsappUrl(messages.nav)} class={`hidden rounded-full px-6 py-3 text-[.95rem] font-semibold transition-colors lg:inline-block ${btn}`}>
    Agendar sessão
  </a>
</header>
</div>
