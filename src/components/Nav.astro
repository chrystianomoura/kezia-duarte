---
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { nav, site, whatsappUrl, messages } from '../data/content';
interface Props { tone?: 'dark' | 'light'; class?: string }
const { tone = 'dark', class: cls = '' } = Astro.props;
const link = tone === 'dark' ? 'font-medium text-[#25506f] hover:text-sereno' : 'text-white/90 hover:text-white';
const btn = tone === 'dark' ? 'bg-marinho text-white hover:bg-profundo' : 'bg-white text-marinho hover:bg-nevoa';
---
<header class={`relative z-20 mx-auto flex w-full max-w-6xl items-center justify-center gap-6 px-5 py-6 sm:justify-between sm:px-8 ${cls}`}>
  <Wordmark {tone} />
  <nav class="hidden items-center gap-5 text-[1rem] lg:flex xl:gap-7 xl:text-[1.1rem]" aria-label="Principal">
    {nav.map((i) => <a href={i.href} class={`transition-colors ${link}`}>{i.label}</a>)}
    <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener" aria-label="Instagram" class={`transition-colors ${link}`}><Icon name="instagram" class="h-7 w-7" /></a>
  </nav>
  <a href={whatsappUrl(messages.nav)} class={`hidden rounded-full px-6 py-3 text-[.95rem] font-semibold transition-colors sm:inline-block ${btn}`}>
    Agendar sessão
  </a>
</header>
