---
import Wordmark from './Wordmark.astro';
interface Props { tone?: 'dark' | 'light'; class?: string }
const { tone = 'dark', class: cls = '' } = Astro.props;
---
<!-- A marca fica no topo (centralizada no celular, no desktop fica centralizada sobre o texto da hero, sobreposta à hero para não ocupar altura). A navegação (e o "Agendar sessão") vive no menu flutuante, igual no mobile e no desktop. -->
<header class={`relative z-20 mx-auto flex w-full max-w-6xl items-center justify-center px-5 py-6 max-[399px]:pr-20 sm:px-8 lg:absolute lg:inset-x-0 lg:top-0 lg:justify-start ${cls}`}>
  <!-- No desktop a marca é centralizada sobre o título da hero (largura = 7em do título: 3,6rem no lg, 4,5rem no xl). -->
  <div class="flex justify-center lg:w-[25.2rem] xl:w-[31.5rem]"><div class="rounded-2xl bg-white px-3 py-3.5 shadow-sm shadow-profundo/10 min-[360px]:px-5 lg:px-6"><Wordmark {tone} /></div></div>
</header>
