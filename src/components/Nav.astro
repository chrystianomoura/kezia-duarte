---
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { nav, site, whatsappUrl, messages } from '../data/content';
interface Props { tone?: 'dark' | 'light'; class?: string }
const { tone = 'dark', class: cls = '' } = Astro.props;
const link = tone === 'dark' ? 'font-medium text-[#575d63] hover:text-marinho' : 'text-white/90 hover:text-white';
const btn = tone === 'dark' ? 'bg-marinho text-white hover:bg-profundo' : 'bg-white text-marinho hover:bg-nevoa';
---
<!-- Celular: marca centralizada (em telas estreitas reserva espaço à direita para o botão do menu não ficar sobre ela). Desktop: marca à esquerda, links e CTA. -->
<header class={`relative z-20 mx-auto flex w-full max-w-6xl items-center justify-center gap-6 px-5 py-6 max-[399px]:pr-20 sm:justify-between sm:px-8 ${cls}`}>
  <Wordmark {tone} />
  <nav class="relative hidden items-center gap-5 text-[1rem] lg:flex xl:gap-7 xl:text-[1.1rem]" aria-label="Principal">
    {nav.map((i) => <a href={i.href} class={`transition-colors ${link}`}>{i.label}</a>)}
    <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener" aria-label="Instagram" class={`transition-colors ${link}`}><Icon name="instagram" class="h-7 w-7" /></a>
    <!-- Fio fino só sob os itens do menu (não pega a marca nem o botão). -->
    <span class="absolute inset-x-0 -bottom-3.5 h-px bg-marinho/55" aria-hidden="true"></span>
  </nav>
  <a href={whatsappUrl(messages.nav)} class={`hidden rounded-full px-6 py-3 text-[.95rem] font-semibold transition-colors lg:inline-block ${btn}`}>
    Agendar sessão
  </a>
</header>
