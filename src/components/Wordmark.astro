---
import { site } from '../data/content';
interface Props { tone?: 'dark' | 'light'; stacked?: boolean }
const { tone = 'dark' } = Astro.props;
const main = tone === 'dark' ? 'text-[#33383d]' : 'text-white';
const sub = tone === 'dark' ? 'text-[#575d63]' : 'text-white';
const crp = site.crp.replace('CRP ', 'CRP: ');
---
<!-- A largura do bloco é a do nome; o cargo e o CRP são menores e ficam centralizados abaixo dele. -->
<a href="#inicio" class="inline-flex flex-col leading-none" aria-label={`${site.name}, ${site.role}, ${site.crp}`}>
  <span aria-hidden="true" class={`font-display text-[2.5rem] font-medium tracking-tight sm:text-[2.9rem] ${main}`}>{site.name}</span>
  <span aria-hidden="true" class={`mt-[.12rem] sm:mt-0 pl-[.2em] text-center text-[.7rem] font-semibold tracking-[.2em] sm:text-[.76rem] sm:font-medium ${sub}`}>{site.role.toUpperCase()}</span>
  <span aria-hidden="true" class={`mt-[.33rem] pl-[.2em] text-center text-[.7rem] font-semibold tracking-[.2em] sm:text-[.76rem] sm:font-medium ${sub}`}>{crp.toUpperCase()}</span>
</a>
