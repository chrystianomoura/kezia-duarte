---
import { site } from '../data/content';
interface Props { tone?: 'dark' | 'light'; stacked?: boolean }
const { tone = 'dark' } = Astro.props;
const main = tone === 'dark' ? 'text-marca' : 'text-white';
const sub = tone === 'dark' ? 'text-marca' : 'text-white';
const letters = [...site.role.toUpperCase()];
const crp = site.crp.replace('CRP ', 'CRP: ');
---
<!-- A largura do bloco é a do nome; a linha do cargo distribui as letras até as duas bordas e o CRP fica centralizado. -->
<a href="#inicio" class="inline-flex flex-col leading-none" aria-label={`${site.name}, ${site.role}, ${site.crp}`}>
  <span aria-hidden="true" class={`font-display text-[2.5rem] font-medium tracking-tight sm:text-[2.9rem] ${main}`}>{site.name}</span>
  <span aria-hidden="true" class={`mt-0.5 flex justify-between text-[.8rem] font-semibold sm:text-[.88rem] sm:font-medium ${sub}`}>
    {letters.map((c) => (c === ' ' ? <span class="w-[.7em]"></span> : <span>{c}</span>))}
  </span>
  <span aria-hidden="true" class={`mt-[.47rem] sm:mt-[.56rem] text-center text-[.8rem] font-semibold tracking-[.2em] sm:text-[.88rem] sm:font-medium ${sub}`}>{crp.toUpperCase()}</span>
</a>
