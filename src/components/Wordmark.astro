---
import { site } from '../data/content';
interface Props { tone?: 'dark' | 'light'; stacked?: boolean }
const { tone = 'dark' } = Astro.props;
const main = tone === 'dark' ? 'text-marinho' : 'text-white';
const sub = tone === 'dark' ? 'text-sereno' : 'text-white';
const letters = [...site.role.toUpperCase()];
---
<!-- A largura do bloco é a do nome; a linha de baixo distribui as letras até as duas bordas. -->
<a href="#inicio" class="inline-flex flex-col leading-none" aria-label={`${site.name}, ${site.role}`}>
  <span aria-hidden="true" class={`font-display text-[2.5rem] font-medium tracking-tight sm:text-[2.9rem] ${main}`}>{site.name}</span>
  <span aria-hidden="true" class={`mt-2 flex justify-between text-[.72rem] font-semibold sm:text-[.78rem] sm:font-medium ${sub}`}>
    {letters.map((c) => (c === ' ' ? <span class="w-[.7em]"></span> : <span>{c}</span>))}
  </span>
</a>
