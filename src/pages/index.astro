---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Cta from '../components/Cta.astro';
import Photo from '../components/Photo.astro';
import Wordmark from '../components/Wordmark.astro';
import kezia from '../assets/kezia.jpg';
import sobre from '../assets/sobre.jpg';
import contato from '../assets/contato.jpg';
import Icon from '../components/Icon.astro';
import Eyebrow from '../components/Eyebrow.astro';

import { hero, about, approach, sessions, faq, contact, site, nav, whatsappUrl, messages } from '../data/content';
const [aboutBefore, aboutAfter] = about.title.split('Kezia Duarte');
const approachKey = 'sua singularidade';
const [approachBefore, approachAfter] = approach.title.split(approachKey);
---
<Base>
  <!-- Menu mobile: o botão flutuante abre um cartão marinho que cresce a partir do canto do botão. -->
  <button id="menu-btn" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-panel" class="fixed right-4 top-[26px] z-[60] flex h-14 w-14 items-center justify-center rounded-full bg-marinho text-white shadow-lg shadow-marinho/30 transition-[background-color,color,right] duration-300 data-[open=true]:right-[26px] data-[open=true]:bg-white data-[open=true]:text-marinho sm:top-[29px] lg:hidden">
    <svg class="absolute h-6 w-6 transition-all duration-300 [[data-open=true]_&]:rotate-90 [[data-open=true]_&]:scale-50 [[data-open=true]_&]:opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    <svg class="absolute h-7 w-7 -rotate-90 scale-50 opacity-0 transition-all duration-300 [[data-open=true]_&]:rotate-0 [[data-open=true]_&]:scale-100 [[data-open=true]_&]:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <div id="menu-backdrop" class="pointer-events-none fixed inset-0 z-40 bg-marinho/40 opacity-0 transition-opacity duration-500 lg:hidden"></div>
  <nav id="menu-panel" aria-label="Menu" aria-hidden="true" inert class="menu-panel fixed inset-x-3 top-3 z-50 overflow-hidden rounded-[2rem] bg-marinho px-7 pb-6 pt-3 text-white shadow-2xl shadow-marinho/40 lg:hidden">
    <ul class="relative mx-auto w-fit divide-y divide-white/20 text-center">
      {nav.map((i, n) => (
        <li>
          <a href={i.href} class="menu-link group block px-3 py-3" style={`--d:${n * 45 + 120}ms`}>
            <span class="font-display text-[2rem] leading-none transition-colors group-hover:text-sereno-claro">{i.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="menu-link relative mt-5" style={`--d:${nav.length * 45 + 160}ms`}>
      <Cta variant="branco" label="Agendar sessão" message={messages.nav} class="w-full justify-center !text-[1.2rem] !leading-6" />
    </div>
  </nav>
  <!-- Início -->
  <section id="inicio" class="relative flex min-h-[100svh] flex-col overflow-hidden bg-creme">
    <Nav />
    <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col items-center gap-7 px-5 pt-4 text-center sm:px-8 lg:grid lg:grid-cols-[1.1fr_.9fr] pb-8 lg:content-center lg:items-center lg:gap-12 lg:pb-10 lg:pt-16 lg:text-left">
      <div class="w-full">
        <!-- Desktop/tablet: três linhas de comprimento parecido, todas no mesmo corpo e justificadas até a largura da mais longa. No celular a frase quebra normalmente. -->
        <h1 class="rise rise-2 text-balance font-display text-5xl font-semibold italic leading-[1.06] text-marinho sm:mx-auto sm:w-fit sm:text-[4rem] lg:mx-0 lg:text-[3.7rem] xl:text-[4.3rem]">
          <span class="sm:block sm:whitespace-nowrap sm:[text-align-last:justify]">Você não precisa ter</span>{' '}
          <span class="sm:block sm:whitespace-nowrap sm:[text-align-last:justify]">todas as respostas para</span>{' '}
          <span class="sm:block sm:whitespace-nowrap sm:[text-align-last:justify]">começar a se escutar.</span>
        </h1>
        <p class="rise rise-3 body-text mx-auto mt-6 max-w-xl text-balance text-[#575d63] lg:mx-0 lg:mt-7">{hero.text}</p>
        <div class="rise rise-4 mt-7 flex justify-center lg:mt-9 lg:justify-start">
          <Cta label={hero.cta} message={messages.hero} />
        </div>
      </div>
      <!-- Foto original dentro de uma moldura branca em arco (mobile e desktop). -->
      <div class="rise rise-3 relative mx-auto w-full max-w-sm lg:-my-12 lg:mx-0 lg:flex lg:max-w-none lg:items-stretch lg:justify-center lg:self-stretch lg:[contain:size] xl:left-6">
        <!-- Desktop: a moldura tem a altura do bloco de texto (do título ao botão), então topo e fundo ficam alinhados. -->
        <div class="relative rounded-t-[999px] rounded-b-[2rem] bg-moldura p-2.5 shadow-xl shadow-profundo/10 lg:aspect-[3/4] lg:h-full lg:p-3">
          <Photo shape="arch" src={kezia} alt="Kezia Duarte, psicóloga clínica, sorrindo" position="55% 22%" loading="eager" class="aspect-[3/4] w-full lg:h-full lg:aspect-auto" />
        </div>
      </div>
    </div>
  </section>

  <!-- Quem sou -->
  <section id="sobre" class="scroll-mt-0 bg-creme py-8 lg:pb-10 lg:pt-8">
    <!-- Desktop: rótulo e título centralizados na página; abaixo, foto e texto lado a lado, alinhados pelo centro. -->
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 px-5 sm:px-8 lg:max-w-7xl lg:grid-cols-[.85fr_1.15fr] lg:items-start lg:gap-x-12">
      <div class="order-1 lg:col-span-2 lg:row-start-1">
        <Eyebrow class="justify-center">Sobre mim</Eyebrow>
        <h2 class="mt-4 text-balance text-center font-display text-4xl font-medium leading-[1.08] text-marinho sm:text-5xl">{aboutBefore}Kezia Duarte{aboutAfter}</h2>
      </div>
      <div class="reveal order-2 mx-auto w-full max-w-sm lg:col-start-2 lg:row-start-2 lg:max-w-none">
        <div class="space-y-4 text-pretty lg:space-y-6 lg:rounded-[2rem] lg:bg-white lg:p-10">
          {about.paragraphs.map((p) => <p class="body-text rounded-[1.75rem] bg-white px-6 py-5 sm:px-8 sm:py-6 lg:rounded-none lg:bg-transparent lg:p-0">{p}</p>)}
        </div>
      </div>
      <div class="reveal order-3 relative mx-auto w-full max-w-sm lg:col-start-1 lg:row-start-2 lg:max-w-none lg:self-stretch">
        <div class="rounded-[2.75rem] bg-moldura p-2.5 shadow-xl shadow-profundo/10 lg:hidden">
          <Photo shape="soft" src={sobre} alt="Kezia Duarte, psicóloga clínica, sorrindo" position="50% 32%" class="aspect-[4/5] w-full" />
        </div>
        <!-- Desktop: foto em moldura branca, esticada até a altura do card de texto. -->
        <div class="hidden h-full rounded-[3.25rem] bg-moldura p-3 shadow-xl shadow-profundo/10 lg:block">
          <Photo shape="soft" src={sobre} alt="Kezia Duarte, psicóloga clínica, sorrindo" position="50% 32%" class="h-full w-full" />
        </div>
      </div>
    </div>
  </section>

  <!-- Abordagem -->
  <section id="abordagem" class="relative scroll-mt-0 lg:scroll-mt-[-4rem] overflow-hidden bg-marinho py-8 text-white lg:py-24">
    <div class="reveal mx-auto max-w-4xl px-5 text-center sm:px-8">
      <Eyebrow tone="dark" class="justify-center">Minha abordagem</Eyebrow>
      <h2 class="mt-4 text-balance font-display text-[2.5rem] font-medium leading-[1.08] sm:text-5xl lg:text-[4rem]">{approachBefore}<em class="whitespace-nowrap font-normal text-verde-claro">{approachKey}</em>{approachAfter}</h2>
      <div class="mx-auto mt-7 h-[3px] w-24 rounded-full bg-verde-claro lg:w-32" aria-hidden="true"></div>
      <div class="mx-auto mt-9 max-w-3xl space-y-5 text-left text-pretty lg:text-center lg:text-balance">
        {approach.paragraphs.map((p) => <p class="body-text !text-white/90">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Psicoterapia -->
  <section id="psicoterapia" class="relative scroll-mt-0 lg:scroll-mt-[-4rem] overflow-hidden bg-creme py-8 lg:py-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="reveal mx-auto max-w-3xl text-center">
        <Eyebrow class="justify-center">Psicoterapia</Eyebrow>
        <h2 class="mt-4 font-display text-4xl font-medium leading-[1.08] text-marinho sm:text-5xl">{sessions.title}</h2>
        <p class="body-text mt-6 text-center sm:text-left lg:text-center">{sessions.text}</p>
      </div>
      <ul class="mx-auto mt-6 grid max-w-4xl grid-cols-1 gap-5 sm:grid-cols-2">
        {sessions.cards.map((c) => (
          <li class="reveal rounded-3xl border border-sereno/20 bg-white p-8 text-center shadow-sm shadow-profundo/5">
            <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-verde-claro text-verde"><Icon name={c.icon as any} class="h-7 w-7" /></span>
            <h3 class="mt-5 text-balance font-display text-[1.4rem] font-semibold leading-tight text-marinho" set:html={c.title.replace(/(\S+-\S+)/g, '<span class="whitespace-nowrap">$1</span>')} />
            <p class="body-text mt-3 text-balance">{c.text}</p>
          </li>
        ))}
      </ul>
      <div class="reveal mt-8 flex justify-center lg:mt-12"><Cta label={sessions.cta} message={messages.sessions} /></div>
    </div>
  </section>

  <!-- Dúvidas -->
  <section id="duvidas" class="relative scroll-mt-0 lg:scroll-mt-[-2rem] overflow-hidden bg-nevoa py-8 lg:py-16">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 px-5 sm:px-8 lg:gap-10">
      <div class="reveal">
        <Eyebrow class="justify-center">Dúvidas frequentes</Eyebrow>
        <h2 class="mt-4 text-balance text-center font-display text-4xl font-medium leading-[1.08] text-marinho sm:text-5xl lg:text-[3.4rem]"><span class="lg:block lg:whitespace-nowrap">Perguntas que costumam surgir</span>{' '}<span class="lg:block lg:whitespace-nowrap">antes do primeiro contato.</span></h2>
      </div>
      <div class="reveal mx-auto grid w-full max-w-[50rem] items-start gap-3 [overflow-anchor:none] lg:gap-4">
        {faq.map((f) => (
          <details class="group rounded-2xl bg-white px-5 py-1 shadow-sm shadow-profundo/5 lg:px-6">
            <summary class="flex cursor-pointer select-none list-none items-center justify-center gap-4 py-5 text-center text-balance text-[1.2rem] font-medium text-marinho sm:justify-between sm:gap-6 sm:text-left sm:text-pretty sm:text-[1.3rem] marker:content-none [&::-webkit-details-marker]:hidden">
              <span>{f.q.slice(0, f.q.lastIndexOf(' ') + 1)}<span class="whitespace-nowrap">{f.q.slice(f.q.lastIndexOf(' ') + 1)}<span class="ml-2 inline-flex h-6 w-6 items-center justify-center rounded-full border border-verde/30 bg-verde-claro align-[-3px] text-verde-escuro sm:hidden" aria-hidden="true"><svg class="h-3.5 w-3.5 transition-transform duration-300 group-data-[open=true]:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v16M5.5 13.5 12 20l6.5-6.5" /></svg></span></span></span>
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-sereno/40 text-sereno transition-transform group-data-[open=true]:rotate-45 max-sm:hidden" aria-hidden="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </summary>
            <p class="body-text max-w-2xl pb-6">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contato -->
  <section id="contato" class="relative scroll-mt-0 lg:scroll-mt-[-2rem] overflow-hidden bg-creme py-8 lg:py-16">
    <div class="reveal mx-auto max-w-6xl px-5 sm:px-8 lg:max-w-7xl">
      <Eyebrow class="justify-center">Contato</Eyebrow>
    <!-- Desktop: um bloco grande e branco com o texto e a foto dentro; no celular a foto e a caixa de texto ficam separadas. -->
    <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-[1.08fr_.92fr] lg:items-stretch lg:gap-6 lg:rounded-[2rem] lg:bg-white lg:p-3 lg:shadow-sm lg:shadow-profundo/5">
      <div class="relative rounded-[2rem] bg-white p-6 shadow-sm shadow-profundo/5 sm:p-10 lg:rounded-none lg:bg-transparent lg:p-9 lg:shadow-none">
        <h2 class="font-display text-4xl font-medium leading-[1.08] text-marinho sm:text-5xl lg:text-[3.4rem]">{contact.title}</h2>
        <p class="body-text mt-6 max-w-xl text-balance">{contact.text}</p>
        <div class="mt-9 flex justify-center lg:justify-start"><Cta label={contact.cta} message={messages.contact} /></div>
        <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-5 sm:flex sm:flex-wrap sm:justify-center sm:gap-x-10 sm:gap-y-4 lg:flex-col lg:items-start lg:justify-start">
          {[
            { icon: 'whatsapp', label: site.whatsappLabel, href: whatsappUrl() },
            { icon: 'instagram', label: `@${site.instagram}`, href: `https://instagram.com/${site.instagram}` },
            { icon: 'mail', label: site.email, href: `mailto:${site.email}` },
          ].map((c) => (
            <li class={`text-center sm:text-left ${c.icon === 'mail' ? 'col-span-2 sm:flex sm:basis-full sm:justify-center lg:basis-auto lg:justify-start' : ''}`}>
              <a href={c.href} class={`group inline-flex text-lg font-medium text-verde-escuro transition-colors hover:text-verde sm:text-xl flex-col items-center gap-2 text-center sm:flex-row sm:gap-4 sm:text-left`}>
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-verde/30 bg-verde-claro text-verde-escuro transition-colors group-hover:bg-verde group-hover:text-white"><Icon name={c.icon as any} class={c.icon === 'whatsapp' ? 'h-6 w-6' : 'h-[26px] w-[26px]'} /></span>                <span class="break-all">{c.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="relative order-first mx-auto w-full max-w-sm lg:order-none lg:mx-0 lg:max-w-none">
        <div class="rounded-[2rem] bg-moldura p-2.5 shadow-xl shadow-profundo/10 lg:h-full lg:rounded-none lg:bg-transparent lg:p-0 lg:shadow-none">
          <Photo shape="soft" src={contato} alt="Consultório acolhedor, com duas poltronas, mesa de centro e luz suave" position="50% 50%" class="aspect-square w-full lg:aspect-auto lg:h-full lg:!rounded-[1.25rem]" />
        </div>
      </div>
    </div>
    </div>
  </section>

  <footer class="bg-marinho text-white">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="flex flex-col gap-7 py-9 md:flex-row md:items-center md:justify-between">
        <div class="flex justify-center md:justify-start"><Wordmark tone="light" /></div>
        <nav aria-label="Rodapé">
          <ul class="mx-auto grid w-full max-w-[21rem] grid-cols-2 gap-3 sm:w-fit sm:max-w-none sm:grid-cols-3">
            {nav.map((i) => (
              <li><a href={i.href} class="flex w-full items-center justify-center rounded-full bg-white py-2 text-[1rem] font-semibold text-marinho transition-colors hover:bg-nevoa sm:w-40">{i.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <p class="border-t border-sereno-claro/45 py-4 text-center text-base font-medium text-nevoa">
        © {new Date().getFullYear()}<span class="mx-1.5 lg:hidden"> </span><span aria-hidden="true" class="mx-3 hidden lg:inline-block h-[5px] w-[5px] rounded-full bg-sereno-claro align-middle"></span>{site.fullName}<span aria-hidden="true" class="mx-3 hidden lg:inline-block h-[5px] w-[5px] rounded-full bg-sereno-claro align-middle"></span><span class="block lg:inline">{site.crp}</span>
      </p>
    </div>
  </footer>
</Base>

<script is:inline>
  // Revela as seções ao rolar; sem JS ou com movimento reduzido, tudo aparece normalmente.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  }
</script>

<script is:inline>
  // FAQ: anima a altura do <details> (abrir e fechar) e mantém só um aberto por vez. Sem JS ou com movimento reduzido, abre direto.
  (() => {
    const items = [...document.querySelectorAll('#duvidas details')];
    // O ícone (+/×) gira pelo data-open, que muda no clique; o atributo `open` só muda no fim da animação.
    const sync = (d) => { d.dataset.open = d.open; };
    items.forEach((d) => {
      sync(d);
      d.addEventListener('toggle', () => sync(d));
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      items.forEach((d) => d.addEventListener('toggle', () => {
        if (d.open) items.forEach((o) => { if (o !== d) o.open = false; });
      }));
      return;
    }
    const ctl = new Map();
    items.forEach((d) => {
      const summary = d.querySelector('summary');
      const body = d.querySelector('summary ~ *');
      let isOpen = d.open;
      let run = 0;
      const set = (next) => {
        if (next === isOpen) return;
        const id = ++run;
        const from = d.offsetHeight; // altura atual, mesmo no meio de uma animação
        d.getAnimations().forEach((a) => a.cancel());
        isOpen = next;
        d.dataset.open = isOpen;
        if (isOpen) d.open = true;
        const cs = getComputedStyle(d);
        const closedH = summary.offsetHeight + parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
        const to = isOpen ? d.scrollHeight : closedH;
        const opts = { duration: 420, easing: 'cubic-bezier(.4,0,.2,1)' };
        d.style.overflow = 'hidden';
        const anim = d.animate({ height: [from + 'px', to + 'px'] }, opts);
        body.animate({ opacity: isOpen ? [0, 1] : [1, 0] }, opts);
        anim.onfinish = () => {
          if (id !== run) return;
          d.open = isOpen;
          d.style.overflow = '';
        };
      };
      ctl.set(d, { set, get isOpen() { return isOpen; } });
      summary.addEventListener('click', (e) => {
        e.preventDefault();
        if (!isOpen) ctl.forEach((c, o) => { if (o !== d && c.isOpen) c.set(false); });
        set(!isOpen);
      });
    });
  })();
</script>

<script is:inline>
  // Menu mobile: abre/fecha o cartão, trava a rolagem e fecha ao tocar num link, no fundo ou com Esc.
  (() => {
    const btn = document.getElementById('menu-btn');
    const panel = document.getElementById('menu-panel');
    const backdrop = document.getElementById('menu-backdrop');
    const set = (open) => {
      btn.dataset.open = open;
      btn.setAttribute('aria-expanded', open);
      btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      panel.classList.toggle('is-open', open);
      panel.toggleAttribute('inert', !open);
      panel.setAttribute('aria-hidden', !open);
      backdrop.classList.toggle('opacity-0', !open);
      backdrop.classList.toggle('pointer-events-none', !open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => set(btn.dataset.open !== 'true'));
    backdrop.addEventListener('click', () => set(false));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  })();
</script>
